# Environment configuration for Nexam CBT Platform
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL 16 connection string
DATABASE_URL=postgresql://nexam_user:nexam_secret_password@localhost:5432/nexam?schema=public

# Database credentials (used by Docker Compose)
POSTGRES_DB=nexam
POSTGRES_USER=nexam_user
POSTGRES_PASSWORD=nexam_secret_password
POSTGRES_PORT=5432

# Secret for signing session cookies and HMAC tokens (at least 64 characters)
SESSION_SECRET=nexam_super_secure_random_session_secret_key_at_least_64_characters_long_for_security_2026

# MinIO (S3 compatible object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=nexam_minio_admin
MINIO_SECRET_KEY=nexam_minio_secret_password_2026
MINIO_BUCKET_NAME=nexam-media

# Rate Limiting & Anti-Cheat Defaults
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
HEARTBEAT_INTERVAL_SECONDS=30
